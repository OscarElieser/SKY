<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Experimental only: notification access is explicitly opt-in,
             never declared in the standard Play-Protect-compatible APK. -->
        <service android:name=".SkyPlaybackProofListener"
            android:label="SKY · Verificar reproducción musical"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Separate experimental build only. Requires a deliberate user opt-in.
             Do not distribute as the standard SKY Android APK. -->
        <service android:name=".SkyTextAssistService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="SKY · Escritura asistida">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/sky_text_assist_config" />
        </service>
        <!-- Research-only variant: never included in signed standard APK. -->
        <service android:name=".SkyMusicControlService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="SKY · Control musical asistido">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/sky_music_control_config" />
        </service>
    </application>
</manifest>
