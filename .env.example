# Copiar a .env en tu equipo; no subir .env a GitHub
# Gemini API: clave obtenida en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Motor multi-IA de SKY: la selección manual evita consultas inesperadas
# No compartas claves ni publiques este archivo real (.env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=llama3.2

# Motor de texto local complementario OpenJarvis: NO sustituye SKY ni se enciende solo.
# Instalar OpenJarvis en una carpeta/venv separada; usar --agent simple.
# Solo se selecciona manualmente; la API existente de SKY sigue en 8765.
SKY_OPENJARVIS_ENABLED=0
# Modelo exacto expuesto por http://127.0.0.1:8000/v1/models (ej. qwen2.5:7b)
SKY_OPENJARVIS_MODEL=
SKY_OPENJARVIS_PORT=8000
# Un solo inicio desde SKY_INICIAR.bat -> 0; arranque opcional y sin descargas.
# SKY_OPENJARVIS_HOME=C:\\Users\\TU_USUARIO\\OpenJarvis
SKY_OPENJARVIS_AUTOSTART=0
# SKY crea subagentes consultivos al detectar tareas de analisis complejas.
# No crea permisos ni ejecuta comandos de sistema ni envia mensajes.
SKY_UNIFIED_AGENTS_ENABLED=1

# BAQUEANO (el repositorio permanece en una rama separada hasta que apruebes el PR)
# Token fine-grained de GitHub limitado a OscarElieser/APP-BAQUEANO con Contents/PR: write.
BAQUEANO_GITHUB_TOKEN=
# Usar únicamente la clave publicable (nunca service_role) para lecturas de tablas públicas.
BAQUEANO_SUPABASE_URL=
BAQUEANO_SUPABASE_PUBLISHABLE_KEY=

# Si compartís SKY en tu red privada Tailscale, definí una clave larga:
# SKY_DASHBOARD_PASSWORD=una-clave-segura-de-16-caracteres-o-mas
# Opcional para cada equipo con agente (recomendado generar token automático):
# SKY_DEVICE_PORT=8765
# SKY_DEVICE_TOKEN=

# Modo manos libres SKY (puede ser auto, gemini, openai, anthropic,
# mistral, groq, deepseek u ollama)
SKY_VOICE_PROVIDER=auto
# Generado individualmente en cada agente si queda vacío:
SKY_DEVICE_TOKEN=

# SKY Engine v6.0: opcional; sin especificar se crea clave local segura
SKY_API_KEY=
# SKY_METAVERSE_DB=

# SKY v9.2: ruta opcional de la base de proyectos (por defecto local_data/sky_projects.sqlite3)
# SKY_PROJECTS_DB=

# SKY v9.7 Creative Studio — rutas locales privadas (opcional)
# SKY_CREATIVE_DIR=local_data/sky_creative
# SKY_CREATIVE_DB=local_data/sky_creative.sqlite3
# SKY_CREATIVE_WORKER=1

# SKY v10.1 — seguridad, idiomas y worker independiente
# Solo añadir dominios bajo tu control; prohíbe comodín *
SKY_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# SKY_LANGUAGE_PREFS=local_data/sky_language_prefs.json
# En producción se recomienda SKY_CREATIVE_WORKER=0 y arrancar sky_render_worker.py
# SKY_CREATIVE_WORKER=0

# SKY v10.2 — MULTILINGUAJE / MFA / DESPLIEGUE CONTROLADO
# Para activar TOTP ejecutá localmente: python scripts/setup_owner_mfa.py
# NUNCA publiques el secreto. La variable debe guardarse solo en tu .env o Vault:
# SKY_OWNER_MFA_SECRET=
SKY_DEPLOYMENT_MODE=local
# Requiere modo public + MFA + Redis + TLS + worker independiente
# SKY_BEHIND_TLS_PROXY=1
# SKY_REDIS_URL=redis://127.0.0.1:6379/0

# SKY v12 — HUD, privacidad local, casa y multimedia
# 100 % local: ningún texto sale del equipo; SKY sólo usa Ollama (ollama serve + ollama pull llama3.1)
# SKY_LOCAL_ONLY=1
# OLLAMA_MODEL=llama3.1
# Voz 100 % local en el HUD: faster-whisper + modelo descargado por vos (carpeta con model.bin y config.json)
# SKY_STT_MODEL_DIR=C:\SKY\modelos\faster-whisper-small
# Puerto del agente del equipo (la API usa 8765)
# SKY_DEVICE_PORT=8766
# Home Assistant (token de larga duración: Perfil → Seguridad → Tokens)
# SKY_HA_URL=http://homeassistant.local:8123
# SKY_HA_TOKEN=
# SKY_HA_AUTO=light,switch,fan,media_player,scene
# Reproductor de YouTube dentro de SKY (API oficial YouTube Data v3)
# YOUTUBE_API_KEY=
# Intérprete de código (Open Interpreter); por defecto ollama/<OLLAMA_MODEL>
# SKY_INTERPRETER_MODEL=ollama/llama3.1

# SKY v12.1 — cerebro, voz natural, agenda, correo y celular
# Cerebro con herramientas (Ollama local). "reglas" lo desactiva.
# SKY_CEREBRO=auto
# Voz natural local (el instalador lo completa solo)
# SKY_PIPER_BIN=C:\Users\TU_USUARIO\.neuralt\piper\piper\piper.exe
# SKY_PIPER_VOICE=C:\Users\TU_USUARIO\.neuralt\piper\voces\es_MX-claude-high.onnx
# SKY_PIPER_SPEED=1.0
# Recordatorios y rutinas programadas
# SKY_AGENDA_ENABLED=1
# Correo con CONTRASEÑA DE APLICACIÓN (Gmail: myaccount.google.com/apppasswords)
# SKY_MAIL_USER=tu_correo@gmail.com
# SKY_MAIL_APP_PASSWORD=
# Avisos al celular con la app de Home Assistant
# SKY_HA_NOTIFY=notify.mobile_app_tu_telefono

# SKY v12.2 — aprendizaje, conocimiento de internet y KPIs reales
# Internet para "aprende sobre…", "noticias de…" y temas que sigue (0 = nunca sale a internet)
# SKY_INTERNET=1
# Registro de KPIs (0 = no medir). Base: ~/.neuralt/sky_metricas.sqlite3
# SKY_METRICAS=1
# SKY_METRICAS_DB=
# Objetivos de servicio (SLO) contra los que se evalúan los KPIs
# SKY_SLO_API_P95_MS=800
# SKY_SLO_DISPONIBILIDAD=99.5
# SKY_SLO_EXITO_TAREAS=95
# SKY_SLO_CEREBRO_P50_MS=4000
# SKY_SLO_PRIMERA_VOZ_MS=1500
# Costo estimado de la IA en la nube (opcional; USD por cada 1000 tokens) y presupuesto mensual
# SKY_COSTO_ANTHROPIC_USD_1K=
# SKY_PRESUPUESTO_USD_MES=

# SKY v12.3 — WhatsApp, skills, tareas programadas y cerebro en la nube
# Cerebro con herramientas: auto (Ollama local) | nube (primer proveedor con clave) | anthropic | openai | gemini | groq | deepseek | mistral
# SKY_CEREBRO=auto
# WhatsApp con la API oficial de Meta (guía: docs/guias/SKY_WHATSAPP.md)
# SKY_WA_TOKEN=
# SKY_WA_TOKEN_FILE=
# SKY_WA_PHONE_ID=
# SKY_WA_APP_SECRET=
# SKY_WA_VERIFY_TOKEN=
# SKY_WA_OWNER=505XXXXXXXX
# SKY_WA_PLANTILLA=
# SKY_WA_PLANTILLA_IDIOMA=es
# SKY_WA_AVISOS=1
# SKY_WA_PORT=8770
# SKY_WA_API_VERSION=v25.0

# SKY v12.4 — creación multimedia (APIs oficiales; tener la cuenta no alcanza, hace falta su API)
# Imágenes con OpenAI (Images API)
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1024x1024
# Imágenes con Adobe Firefly Services (credenciales server-to-server de Adobe Developer Console)
# FIREFLY_CLIENT_ID=
# FIREFLY_CLIENT_SECRET=
# Presentaciones con Gamma (planes Pro o superiores)
# GAMMA_API_KEY=
# Lectura de tus repositorios
# GITHUB_TOKEN=

# SKY v12.5 — SKY SENTINEL (seguridad)
# Toda /api/* exige la llave del dueño. La comunidad multiusuario sólo se abre a otras personas si ponés 1:
# SKY_COMUNIDAD_PUBLICA=0
# Token propio para que sensores (ESP32, PLC…) envíen telemetría sin la llave del dueño (24+ caracteres):
# SKY_TELEMETRIA_TOKEN=
# Rechazar toda conexión que no venga de este equipo (también se activa por voz o en el Security Center):
# SKY_SOLO_LOCAL=0
# El PIN se configura en el HUD: Módulos → Seguridad (se guarda derivado con scrypt en ~/.neuralt/sentinel.json)

# SKY MCP Hub — opcional y DESACTIVADO por defecto
# Instalar SDK solo con: .venv\Scripts\python.exe -m pip install -r requirements_mcp_optional.txt
# La configuración privada vive en ~/.neuralt/mcp-servers.json (fuera de GitHub).
# No se instalan ni arrancan servidores MCP sin solicitud explícita del propietario.
# SKY_MCP_ENABLED=0
# SKY_MCP_ALLOW_WRITES=0
# Filesystem: debe apuntar a UNA carpeta de trabajo propia y no sensible.
# SKY_MCP_FILES_ROOT=C:\Users\TU_USUARIO\Documents\SKY-MCP-Workspace
# Las claves para GitHub, Tavily, Notion, etc. se guardan solo en .env local / Vault,
# nunca en mcp-servers.json, historial de comandos o capturas del HUD.
# GITHUB_PERSONAL_ACCESS_TOKEN=
# TAVILY_API_KEY=
# NOTION_TOKEN=
# SERP_API_KEY=

# SKY Social Hub — cuentas oficiales, vinculadas por OAuth (sin contraseñas).
# Este archivo ejemplo se puede subir; el .env real NUNCA se comparte.
# El usuario debe conceder permisos en cada portal de desarrolladores.
# Facebook: SOLO páginas administradas, no perfiles personales.
SKY_SOCIAL_FACEBOOK_PAGE_ID=
SKY_SOCIAL_FACEBOOK_PAGE_TOKEN=
# Threads: requiere Meta Threads App y threads_content_publish.
SKY_SOCIAL_THREADS_ACCESS_TOKEN=
# X: requiere app X + OAuth 2.0 con tweet.write; interacciones: like.write.
SKY_SOCIAL_X_ACCESS_TOKEN=
SKY_SOCIAL_X_USER_ID=
# Motor de publicaciones programadas: 0=off (por defecto).
# Incluso con 1 solo envía publicaciones ya aprobadas por el propietario.
SKY_SOCIAL_WORKER_ENABLED=0
# SKY_SOCIAL_HUB_DB=local_data/sky_social_hub.sqlite3
# Instagram, TikTok y Snapchat: borradores disponibles. No ingresar claves
# hasta instalar y revisar sus flujos oficiales de medios y API.

# SKY utiliza ComfyUI local para producir imágenes o video con modelos propios
# Requiere ComfyUI previamente instalado, modelos adecuados y workflow en API JSON.
# No descarga modelos ni instala dependencias al arrancar.
SKY_COMFYUI_ENABLED=0
SKY_COMFYUI_PORT=8188
# SKY_COMFYUI_WORKFLOW_IMAGE=C:/SKY-Workflows/imagen_api.json
# SKY_COMFYUI_PROMPT_NODE_IMAGE=6
# SKY_COMFYUI_WORKFLOW_VIDEO=C:/SKY-Workflows/video_api.json
# SKY_COMFYUI_PROMPT_NODE_VIDEO=6

# LM Studio: proveedor local opcional para el cerebro de SKY
SKY_LMSTUDIO_ENABLED=0
SKY_LMSTUDIO_PORT=1234
SKY_LMSTUDIO_MODEL=

# Historial persistente privado; nunca subir archivos SQLite a GitHub
# SKY_HUD_HISTORY_DB=local_data/sky_hud_history.sqlite3

# SKY Diffusers directo: inferencia de imagen offline dentro de SKY.
# Solo modelos instalados legalmente antes de usar, y dependencias opcionales.
SKY_DIFFUSERS_ENABLED=0
# SKY_DIFFUSERS_IMAGE_MODEL_DIR=C:/SKY-Models/imagen-local

# SKY orchestration frameworks: optional real specialists using LM Studio ONLY
SKY_FRAMEWORK_CREWAI_ENABLED=0
SKY_FRAMEWORK_AUTOGEN_ENABLED=0
SKY_FRAMEWORK_LANGCHAIN_ENABLED=0

# Make webhooks: aliases and their official HTTPS endpoints, created by OWNER.
# SKY_MAKE_ALIASES=avisos
# SKY_MAKE_WEBHOOK_AVISOS=https://hook.eu2.make.com/REPLACE_WITH_YOUR_WEBHOOK_ID
# SKY_MAKE_API_KEY_AVISOS=REPLACE_WITH_YOUR_OFFICIAL_KEY
# Los entrenamientos requieren ejecución manual, datos permitidos y GPU compatible.
